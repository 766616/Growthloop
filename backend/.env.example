# Backend environment variables. Copy to .env and load them (see README), or set them in
# your IDE run configuration. Never commit the real .env file.
# Use 127.0.0.1 for local-only development; use 0.0.0.0 to accept LAN connections.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/growthloop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=growthloop_app
DB_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 48   (must be 32+ characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=Mykey123
SEED_DEMO_DATA=true
